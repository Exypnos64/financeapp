<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.2.0" />
  <PropertyGroup>
    <Name>FinanceDb</Name>
    <!-- Sql160 = SQL Server 2022, which matches the container we'll stand up. -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <!-- 1033 = English; CI = case-insensitive collation. -->
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <!-- Seed/reference data: run it after publish (PostDeploy), and keep it OUT
         of the schema model (Build Remove) so it isn't compiled as an object. -->
    <PostDeploy Include="Script.PostDeployment.sql" />
    <Build Remove="Script.PostDeployment.sql" />
  </ItemGroup>
</Project>