### Idempotency: first save (fixed key)
# Send once to create the row. Send it again to ensure idempotency.

POST {{Api_HostAddress}}/transactions
Content-Type: application/json

{
    "accountId": 1,
    "merchantId": 1,
    "categoryId": 1,
    "amount": -42.00,
    "userDate": "2026-09-22T12:00:00-05:00",
    "notes": "Idempotency test",
    "idempotencyKey": "{{Duplicate_Key}}"
}

### Idempotency: same key, different body
# Expect 409 Conflict.

POST {{Api_HostAddress}}/transactions
Content-Type: application/json

{
    "accountId": 1,
    "merchantId": 1,
    "categoryId": 1,
    "amount": -99.00,
    "userDate": "2026-09-22T12:00:00-05:00",
    "notes": "Idempotency test",
    "idempotencyKey": "{{Duplicate_Key}}"
}

### Idempotency: missing key
# Expect 400 (required member missing).

POST {{Api_HostAddress}}/transactions
Content-Type: application/json

{
    "accountId": 1,
    "merchantId": 1,
    "categoryId": 1,
    "amount": -1.00,
    "userDate": "2026-09-22T12:00:00-05:00"
}

### Idempotency: malformed key
# Expect 400 (not a GUID).

POST {{Api_HostAddress}}/transactions
Content-Type: application/json

{
    "accountId": 1,
    "merchantId": 1,
    "categoryId": 1,
    "amount": -1.00,
    "userDate": "2026-09-22T12:00:00-05:00",
    "idempotencyKey": "not-a-guid"
}

